# Neon connection string (Project dashboard -> Connect). Use the *pooled* URL.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require

# Public base URL of the site (used for sitemaps, canonical URLs)
SITE_URL=http://localhost:3000

# Auth (Better Auth). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Google sign-in: Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web).
# Authorised redirect URI: {SITE_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend). Without RESEND_API_KEY, emails are printed to the console instead.
RESEND_API_KEY=
EMAIL_FROM="Sponsorship Hunter <onboarding@resend.dev>"

# Optional: brand name shown on the site and in emails (default "Sponsorship Hunter")
SITE_NAME=

# Optional: contact address shown on /privacy (default privacy@sponsorshiphunter.com)
CONTACT_EMAIL=

# Optional: Companies House API key (free) for better website matching.
# https://developer.company-information.service.gov.uk/ -> Your applications -> Create an application -> REST API key
COMPANIES_HOUSE_API_KEY=

# Data API (/api/v1, docs/10-data-api.md): comma-separated keys, 16+ chars. Unset = API off.
API_KEYS=
# Optional: origins allowed to call it from a browser
API_CORS_ORIGINS=

# Admin dashboard (/admin, docs/11-admin.md): comma-separated emails allowed in
ADMIN_EMAILS=
